<Window x:Class="PersonalFitnessPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人健身计划" Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded" Closing="MainWindow_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#101828" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Personal Fitness Planner" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="  Windows" Foreground="#98A2B3" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding GlobalStatus}" Foreground="#D0D5DD" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="立即同步" Command="{Binding SyncCommand}" Padding="14,5" MinHeight="30" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#EEF2F7">
            <StatusBarItem Content="{Binding FooterStatus}" />
            <Separator />
            <StatusBarItem Content="{Binding DataDirectory}" />
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="{DynamicResource WindowBrush}">
            <TabItem Header="首页" IsEnabled="{Binding PersonalDataAvailable}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Dashboard.DateText}" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.WeekdayText}" Foreground="{DynamicResource MutedBrush}" FontSize="16" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E8F2FF" CornerRadius="8" Padding="18,10">
                                <StackPanel>
                                    <TextBlock Text="今日建议" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Dashboard.Recommendation}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,8">
                            <GroupBox Header="当前计划">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.PlanName}" Style="{StaticResource MetricText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Dashboard.PlanVersionText}" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="本周进度">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.ProgressText}" Style="{StaticResource MetricText}" />
                                    <ProgressBar Value="{Binding Dashboard.ProgressPercent}" Height="7" Maximum="100" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="下一次">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.NextDay}" Style="{StaticResource MetricText}" />
                                    <TextBlock Text="按完成记录交替" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="同步状态">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dashboard.SyncStatus}" Style="{StaticResource MetricText}" />
                                    <TextBlock Text="训练离线可用" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </GroupBox>
                        </UniformGrid>

                        <WrapPanel Grid.Row="2" Margin="4,6,4,14">
                            <Button Content="开始训练" Command="{Binding Dashboard.StartWorkoutCommand}" />
                            <Button Content="今天休息" Command="{Binding Dashboard.MarkRestCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Content="改为有氧" Command="{Binding Dashboard.MarkCardioCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Content="刷新" Command="{Binding Dashboard.RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                            <TextBlock Text="疲劳 0–10" VerticalAlignment="Center" Margin="14,0,2,0" />
                            <TextBox Width="52" Text="{Binding Dashboard.FatigueScoreText}" />
                            <TextBlock Text="睡眠 1–5" VerticalAlignment="Center" Margin="6,0,2,0" />
                            <TextBox Width="52" Text="{Binding Dashboard.SleepQualityText}" />
                            <TextBox Width="150" Text="{Binding Dashboard.PainNotes}" ToolTip="疼痛部位/备注" />
                            <Button Content="保存状态" Command="{Binding Dashboard.SaveReadinessCommand}" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>

                        <GroupBox Grid.Row="3" Header="最近训练">
                            <DataGrid ItemsSource="{Binding Dashboard.RecentWorkouts}" IsReadOnly="True" MinHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日期" Binding="{Binding LocalDate}" Width="120" />
                                    <DataGridTextColumn Header="A/B" Binding="{Binding DayCode}" Width="70" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="组数" Binding="{Binding SetCount}" Width="80" />
                                    <DataGridTextColumn Header="容量 (kg)" Binding="{Binding VolumeKg}" Width="120" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="100" />
                                    <DataGridTextColumn Header="同步" Binding="{Binding SyncStatus}" Width="100" />
                                    <DataGridTextColumn Header="动作" Binding="{Binding ExerciseNames}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="训练执行" IsEnabled="{Binding PersonalDataAvailable}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="520" />
                        <ColumnDefinition Width="2*" MinWidth="360" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Workout.SessionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Workout.ResumeText}" Foreground="{DynamicResource WarningBrush}" Margin="12,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="开始/恢复" Command="{Binding Workout.StartOrResumeCommand}" Style="{StaticResource SecondaryButton}" />
                                <Button Content="完成训练" Command="{Binding Workout.CompleteWorkoutCommand}" />
                                <Button Content="提前结束" Command="{Binding Workout.EndEarlyCommand}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="1" Header="训练顺序">
                        <DataGrid ItemsSource="{Binding Workout.Items}" SelectedItem="{Binding Workout.SelectedItem, Mode=TwoWay}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" />
                                <DataGridTextColumn Header="部位" Binding="{Binding BodyPart}" Width="100" />
                                <DataGridTextColumn Header="动作" Binding="{Binding SelectedOption.ExerciseName}" Width="*" />
                                <DataGridTextColumn Header="器械" Binding="{Binding SelectedOption.Equipment}" Width="170" />
                                <DataGridTextColumn Header="处方" Binding="{Binding Prescription}" Width="100" />
                                <DataGridTextColumn Header="已完成" Binding="{Binding CompletedSets}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="动作与替代">
                                <StackPanel>
                                    <TextBlock Text="{Binding Workout.SelectedItem.BodyPart}" FontSize="20" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Workout.SelectedItem.Options}" SelectedItem="{Binding Workout.SelectedItem.SelectedOption, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                                    <TextBlock Text="动作要点" FontWeight="SemiBold" Margin="4,10,4,2" />
                                    <TextBlock Text="{Binding Workout.SelectedItem.Cues}" TextWrapping="Wrap" Margin="4" />
                                    <TextBlock Text="常见错误" FontWeight="SemiBold" Margin="4,10,4,2" />
                                    <TextBlock Text="{Binding Workout.SelectedItem.CommonMistakes}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="4" />
                                    <TextBlock Text="{Binding Workout.SelectedItem.LastRecord}" Foreground="{DynamicResource MutedBrush}" Margin="4,8" />
                                    <TextBlock Text="{Binding Workout.SelectedItem.Suggestion}" Foreground="{DynamicResource SuccessBrush}" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="器械设置">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="座椅位置" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Workout.SelectedItem.SeatPosition, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="凳角" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Workout.SelectedItem.BenchAngle, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="器械编号" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Workout.SelectedItem.MachineNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="记录本组（Ctrl+Enter）">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock><Run Text="重量 ("/><Run Text="{Binding Workout.UnitLabel}"/><Run Text=")"/></TextBlock><TextBlock Grid.Column="1" Text="次数/秒" /><TextBlock Grid.Column="2" Text="RIR" />
                                    <TextBox Grid.Row="1" Text="{Binding Workout.WeightText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Workout.RepsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Workout.RirText, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="出现疼痛（本组不会触发加重建议）" IsChecked="{Binding Workout.Pain}" Margin="4,8" />
                                    <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Workout.SetNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="本组备注" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="保存本组" Command="{Binding Workout.SaveSetCommand}" />
                                    <Button Content="修改上一组" Command="{Binding Workout.UpdatePreviousSetCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="组间计时">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Workout.TimerText}" FontSize="30" FontWeight="SemiBold" Margin="8" />
                                    <Button Content="开始/暂停" Command="{Binding Workout.ToggleTimerCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="重置" Command="{Binding Workout.ResetTimerCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="历史" IsEnabled="{Binding PersonalDataAvailable}">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="从" VerticalAlignment="Center" Margin="6" />
                        <DatePicker SelectedDate="{Binding History.FromDate}" Margin="4" />
                        <TextBlock Text="到" VerticalAlignment="Center" Margin="6" />
                        <DatePicker SelectedDate="{Binding History.ToDate}" Margin="4" />
                        <ComboBox Width="110" ItemsSource="{Binding History.DayFilters}" SelectedItem="{Binding History.SelectedDayFilter}" />
                        <TextBox Width="180" Text="{Binding History.ExerciseFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="动作筛选" />
                        <Button Content="查询" Command="{Binding History.RefreshCommand}" />
                        <TextBox Width="75" Text="{Binding History.EditWeightText}" ToolTip="修改最后一组重量 kg" />
                        <TextBox Width="65" Text="{Binding History.EditRepsText}" ToolTip="修改最后一组次数" />
                        <TextBox Width="55" Text="{Binding History.EditRirText}" ToolTip="修改最后一组 RIR" />
                        <CheckBox Content="疼痛" IsChecked="{Binding History.EditPain}" VerticalAlignment="Center" Margin="4" />
                        <Button Content="编辑最后一组" Command="{Binding History.EditSelectedCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="软删除" Command="{Binding History.DeleteSelectedCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="导出 CSV" Command="{Binding History.ExportCsvCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="导出 JSON" Command="{Binding History.ExportJsonCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="4,4,4,0">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="3"><TextBlock Text="{Binding History.WeightTrendText}" /></Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="3"><TextBlock Text="{Binding History.RepsTrendText}" /></Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="3"><TextBlock Text="{Binding History.VolumeTrendText}" /></Border>
                    </UniformGrid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding History.Rows}" SelectedItem="{Binding History.SelectedRow}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding LocalDate}" Width="110" />
                            <DataGridTextColumn Header="A/B" Binding="{Binding DayCode}" Width="60" />
                            <DataGridTextColumn Header="计划" Binding="{Binding PlanVersion}" Width="140" />
                            <DataGridTextColumn Header="动作" Binding="{Binding ExerciseNames}" Width="*" />
                            <DataGridTextColumn Header="组数" Binding="{Binding SetCount}" Width="70" />
                            <DataGridTextColumn Header="峰值重量*" Binding="{Binding PeakWeightKg}" Width="95" />
                            <DataGridTextColumn Header="总次数" Binding="{Binding TotalReps}" Width="80" />
                            <DataGridTextColumn Header="容量*" Binding="{Binding VolumeKg}" Width="110" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="同步" Binding="{Binding SyncStatus}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="动作库" IsEnabled="{Binding PersonalDataAvailable}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <GroupBox Header="动作与器械">
                        <DataGrid ItemsSource="{Binding Exercises.Items}" SelectedItem="{Binding Exercises.SelectedItem}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="动作" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="部位" Binding="{Binding BodyPart}" Width="110" />
                                <DataGridTextColumn Header="器械" Binding="{Binding Equipment}" Width="180" />
                                <DataGridTextColumn Header="组次" Binding="{Binding Prescription}" Width="100" />
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="动作详情">
                                <StackPanel>
                                    <TextBlock Text="{Binding Exercises.SelectedItem.Name}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Exercises.SelectedItem.Cues}" TextWrapping="Wrap" Margin="0,10" />
                                    <TextBlock Text="常见错误" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Exercises.SelectedItem.CommonMistakes}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="替代动作" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Exercises.SelectedItem.Alternatives}" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="管理草稿" Visibility="{Binding Exercises.IsAdmin, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBox Text="{Binding Exercises.DraftName}" ToolTip="动作名称" />
                                    <TextBox Text="{Binding Exercises.DraftBodyPart}" ToolTip="部位" />
                                    <TextBox Text="{Binding Exercises.DraftEquipment}" ToolTip="器械" />
                                    <TextBox Text="{Binding Exercises.DraftCues}" AcceptsReturn="True" Height="80" ToolTip="动作要点" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="保存草稿" Command="{Binding Exercises.SaveDraftCommand}" />
                                        <Button Content="发布到云端" Command="{Binding Exercises.PublishCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock Text="管理权限由登录令牌角色声明决定" Foreground="{DynamicResource MutedBrush}" Margin="10" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="计划编辑器" IsEnabled="{Binding PersonalDataAvailable}">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="新建草稿" Command="{Binding PlanEditor.CreateDraftCommand}" />
                        <Button Content="保存草稿" Command="{Binding PlanEditor.SaveDraftCommand}" />
                        <Button Content="上移" Command="{Binding PlanEditor.MoveUpCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="下移" Command="{Binding PlanEditor.MoveDownCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="添加位置" Command="{Binding PlanEditor.AddItemCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="删除位置" Command="{Binding PlanEditor.RemoveItemCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="发布新版本" Command="{Binding PlanEditor.PublishCommand}" />
                        <Button Content="分配给当前用户" Command="{Binding PlanEditor.AssignCommand}" />
                        <ComboBox Width="190" ItemsSource="{Binding PlanEditor.Versions}" SelectedItem="{Binding PlanEditor.SelectedVersion}" DisplayMemberPath="DisplayName" />
                        <Button Content="查看版本" Command="{Binding PlanEditor.ViewVersionCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="回滚分配" Command="{Binding PlanEditor.RollbackCommand}" Style="{StaticResource SecondaryButton}" />
                        <TextBlock Text="{Binding PlanEditor.ValidationSummary}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="12,0" />
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                        <TabControl ItemsSource="{Binding PlanEditor.Days}" SelectedItem="{Binding PlanEditor.SelectedDay}">
                            <TabControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Code}" /></DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding DataContext.PlanEditor.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}}" IsReadOnly="{Binding DataContext.PlanEditor.IsPublished, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" IsReadOnly="True" />
                                            <DataGridTextColumn Header="部位" Binding="{Binding BodyPart, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                            <DataGridTextColumn Header="首选动作" Binding="{Binding PreferredExercise, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="器械" Binding="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                            <DataGridTextColumn Header="组" Binding="{Binding Sets, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                            <DataGridTextColumn Header="最少" Binding="{Binding RepMin, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                            <DataGridTextColumn Header="最多" Binding="{Binding RepMax, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                            <DataGridTextColumn Header="休息秒" Binding="{Binding RestSeconds, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                            <DataGridTextColumn Header="替代动作（逗号）" Binding="{Binding Alternatives, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <Border Grid.Column="1" Background="#111827" CornerRadius="24" Margin="12" Padding="14" Width="300" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="手机端预览" Foreground="#98A2B3" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PlanEditor.PlanTitle}" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10" />
                                    <TextBlock Text="{Binding PlanEditor.SelectedDay.Code}" Foreground="#60A5FA" FontSize="22" />
                                </StackPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PlanEditor.SelectedDay.Items}" Background="#111827" BorderThickness="0" Foreground="White">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1F2937" CornerRadius="8" Padding="10" Margin="0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BodyPart}" Foreground="#9CA3AF" FontSize="12" />
                                                    <TextBlock Text="{Binding PreferredExercise}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Prescription}" Foreground="#93C5FD" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" Text="前两周最多 2 个正式组" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <GroupBox Header="API 与登录">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="API 地址" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Settings.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="邮箱" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.LoginEmail, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="密码" VerticalAlignment="Center" /><PasswordBox x:Name="LoginPasswordBox" Grid.Row="2" Grid.Column="1" Margin="4" Padding="8,6" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="登录" Click="LoginButton_Click" />
                                    <Button Content="退出" Command="{Binding Settings.LogoutCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="同步" Command="{Binding Settings.SyncCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="完整重新同步" Command="{Binding Settings.FullSyncCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="上传本地" Command="{Binding Settings.UploadLocalCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="云端覆盖" Command="{Binding Settings.DownloadCloudOverwriteCommand}" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Text="{Binding Settings.AuthenticationText}" Margin="16" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="偏好设置">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="260" /><ColumnDefinition Width="140" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="IANA 时区" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Settings.TimeZone}" />
                                <TextBlock Grid.Column="2" Text="重量单位" VerticalAlignment="Center" /><ComboBox Grid.Column="3" ItemsSource="{Binding Settings.UnitSystems}" SelectedItem="{Binding Settings.UnitSystem}" />
                                <TextBlock Grid.Row="1" Text="训练日" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.TrainingDays}" ToolTip="ISO 星期数字，例如 1,3,5 表示周一、周三、周五" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="主题" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme}" />
                                <CheckBox Grid.Row="2" Grid.Column="1" Content="自动同步" IsChecked="{Binding Settings.AutomaticSync}" Margin="4" />
                                <Button Grid.Row="2" Grid.Column="3" Content="保存设置" Command="{Binding Settings.SaveCommand}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="2" Header="数据、备份与导入导出">
                            <StackPanel>
                                <TextBlock Text="数据目录" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Settings.DataDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="更改后保存并重启应用" />
                                <WrapPanel>
                                    <Button Content="立即备份" Command="{Binding Settings.BackupCommand}" />
                                    <Button Content="导出全部 JSON" Command="{Binding Settings.ExportCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="导入 JSON…" Click="ImportButton_Click" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <TextBlock Text="备份最多保留最近 10 份；修改数据目录需重启应用。" Foreground="{DynamicResource MutedBrush}" Margin="4" />
                                <TextBlock Text="云端覆盖不会先上传本地记录；存在待上传 Outbox 时会自动拒绝，请先上传或备份。" Foreground="{DynamicResource MutedBrush}" Margin="4" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="3" Header="版本信息">
                            <TextBlock Text="{Binding Settings.VersionText}" />
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Workout.SaveSetCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Workout.SaveSetCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SyncCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshDashboardCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
    </Window.InputBindings>
</Window>
