<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PersonalFitnessPlanner.Infrastructure</AssemblyName>
    <RootNamespace>PersonalFitnessPlanner.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PersonalFitnessPlanner.Contracts\PersonalFitnessPlanner.Contracts.csproj" />
    <ProjectReference Include="..\PersonalFitnessPlanner.Core\PersonalFitnessPlanner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Pin the native SQLite bundle independently so security fixes do not lag
         behind the minimum transitive version accepted by Microsoft.Data.Sqlite. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\default-training-plan.json" LogicalName="PersonalFitnessPlanner.DefaultPlan.json" />
  </ItemGroup>
</Project>
