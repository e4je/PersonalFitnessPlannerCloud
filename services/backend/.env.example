ENVIRONMENT=development
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Default: a local SQLite file in the private backend data directory.
DATABASE_BACKEND=sqlite
SQLITE_DATABASE_PATH=
DATABASE_URL=

# Optional MySQL mode. Set DATABASE_BACKEND=mysql, then either fill these
# fields or complete the secured first-run Web wizard. The schema name remains
# fixed as "fitness".
MYSQL_DATABASE=fitness
MYSQL_USER=fitness
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Docker Compose bundled-db service name. For host-side Python, use a host/IP
# reachable from the host process (often 127.0.0.1 for a separately exposed DB).
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Optional override. SQLite mode creates a persistent random key automatically.
JWT_SECRET=
# Used only by the optional MySQL first-run wizard.
SETUP_TOKEN=
JWT_ALGORITHM=HS256
# Comma-separated reverse proxy IPs/networks trusted by Gunicorn/Uvicorn.
# Keep loopback-only unless a local reverse proxy is configured explicitly.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
LOG_LEVEL=INFO
SQL_ECHO=false
MAX_REQUEST_BODY_BYTES=2097152
# Failed logins and valid public-registration attempts per source/minute.
LOGIN_ATTEMPTS_PER_MINUTE=10
SYNC_RETENTION_DAYS=90
DATABASE_WAIT_SECONDS=120

# Optional smoke test credentials.
SMOKE_BASE_URL=http://127.0.0.1:8000
SMOKE_EMAIL=
SMOKE_PASSWORD=

# Use a trusted mirror only when the default package registry is unreachable.
PIP_INDEX_URL=https://pypi.org/simple
