ENVIRONMENT=development
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# The application database name is fixed in code as "fitness".
MYSQL_DATABASE=fitness
MYSQL_USER=fitness
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Docker Compose bundled-db service name. For host-side Python, use a host/IP
# reachable from the host process (often 127.0.0.1 for a separately exposed DB).
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Optional full connection URL for an existing or managed MySQL database.
# Leave empty to construct it safely from the MYSQL_* fields above.
DATABASE_URL=

JWT_SECRET=
# Optional first-run token override. If empty, the backend generates one and
# prints it in its startup logs until database setup is complete.
SETUP_TOKEN=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
LOG_LEVEL=INFO
SQL_ECHO=false
MAX_REQUEST_BODY_BYTES=2097152
# Failed logins and valid public-registration attempts per source/minute.
LOGIN_ATTEMPTS_PER_MINUTE=10
SYNC_RETENTION_DAYS=90
DATABASE_WAIT_SECONDS=120

PIP_INDEX_URL=https://pypi.org/simple
